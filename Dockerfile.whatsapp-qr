FROM node:24.20.0-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf AS dependencies
RUN apk add --no-cache git
WORKDIR /app
COPY worker/whatsapp-qr/package*.json ./
RUN npm ci --ignore-scripts --omit=dev

FROM node:24.20.0-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf
ENV NODE_ENV=production
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY worker/whatsapp-qr/package*.json ./
COPY worker/whatsapp-qr/src/ ./src/
USER node
CMD ["node", "--max-old-space-size=192", "src/main.js"]
