# Copy this file to .env and supply your own values. Never commit .env.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Alternative to ADMIN_PASSWORD: path to a server-only secret file.
# ADMIN_PASSWORD_FILE=/run/secrets/admin_password
DB_PATH=.local/online-shopping.db
PORT=3000
# Required when NODE_ENV=production, for same-origin checks and secure cookies.
PUBLIC_ORIGIN=
# Optional separate seller origin; defaults to PUBLIC_ORIGIN.
SELLER_ORIGIN=
# PostgreSQL alternative to DB_PATH; keep connection credentials private.
# DATABASE_URL=postgresql://user:password@localhost:5432/online_shopping

# Data mode is separate from HTTPS/security environment. Demo seeds an empty store.
SHOP_MODE=manual

# Optional catalog + media UPDATE profile: development/test only, never production.
# Requires safe MCP v2, password login and the sealed local media worker configuration.
MCP_V2_CATALOG_MEDIA_UPDATE_ENABLED=0

# Independent catalog + media CREATE profile: development/test only, never production.
# Requires the same safe MCP v2/password/sealed-worker prerequisites; UPDATE does not enable it.
MCP_V2_CATALOG_MEDIA_CREATE_ENABLED=0

# Isolated Approve & Finish development flow; default OFF, rejected in production.
# Requires MCP v2. See docs/mcp-v2/ONE-CLICK-FINISH.md for incomplete release gates.
MCP_V2_FINISH_ENABLED=0
