# Copy this file to .env and supply your own values. Never commit .env.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Alternative to ADMIN_PASSWORD: path to a server-only secret file.
# ADMIN_PASSWORD_FILE=/run/secrets/admin_password
DB_PATH=.local/online-shopping.db
PORT=3000
# Required when NODE_ENV=production, for same-origin checks and secure cookies.
PUBLIC_ORIGIN=
# Optional separate seller origin; defaults to PUBLIC_ORIGIN.
SELLER_ORIGIN=
# PostgreSQL alternative to DB_PATH; keep connection credentials private.
# DATABASE_URL=postgresql://user:password@localhost:5432/online_shopping

# Data mode is separate from HTTPS/security environment. Demo seeds an empty store.
SHOP_MODE=manual
