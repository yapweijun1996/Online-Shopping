{
  "version": "2.1",
  "tiers": [
    {
      "id": "favicon",
      "source": "pomelo-compact.svg",
      "size": {
        "min": 16,
        "max": 48
      },
      "where": "Browser tabs and favicon links",
      "fallback": "favicon.svg"
    },
    {
      "id": "header-wordmark-mark",
      "source": "pomelo-compact.svg",
      "size": {
        "min": 24,
        "max": 64
      },
      "where": "Site header and compact wordmark marks",
      "fallback": "pomelo-icon-square.svg"
    },
    {
      "id": "small-ui-pwa",
      "source": "pomelo-icon-square.svg",
      "size": {
        "values": [
          180,
          192,
          512
        ]
      },
      "where": "PWA any icons and Apple touch icon",
      "fallback": "pomelo-compact.svg"
    },
    {
      "id": "maskable-pwa",
      "source": "pomelo-icon-maskable.svg",
      "size": {
        "values": [
          192,
          512
        ]
      },
      "where": "Maskable PWA icons",
      "fallback": "pomelo-icon-square.svg"
    },
    {
      "id": "hero-large-brand-art",
      "source": "pomelo-master-detailed.svg",
      "size": {
        "min": 128
      },
      "where": "Large brand art only",
      "fallback": "pomelo-compact.svg"
    },
    {
      "id": "placeholder-loader-light",
      "source": "pomelo-placeholder-loader.svg",
      "size": {
        "min": 24
      },
      "where": "Light skeleton/loading states",
      "fallback": "pomelo-placeholder-static.svg"
    },
    {
      "id": "placeholder-loader-dark",
      "source": "pomelo-placeholder-loader-dark.svg",
      "size": {
        "min": 24
      },
      "where": "Dark skeleton/loading states",
      "fallback": "pomelo-placeholder-static-dark.svg"
    },
    {
      "id": "placeholder-static-reduced-motion",
      "source": "pomelo-placeholder-static.svg",
      "size": {
        "min": 24
      },
      "where": "Reduced-motion skeleton/loading states",
      "fallback": "pomelo-placeholder-static-dark.svg"
    },
    {
      "id": "full-screen-animation",
      "source": "pomelo-loader.svg",
      "size": {
        "min": 128
      },
      "where": "Opt-in PWA launch splash only",
      "fallback": "pomelo-placeholder-static.svg"
    },
    {
      "id": "social-og",
      "source": null,
      "size": null,
      "where": "Future; no trivial approved derivative",
      "fallback": null
    }
  ],
  "rules": [
    "Detailed art is never scaled below 128 px.",
    "Compact art is never used above 128 px for hero art.",
    "Every deployed logo under assets/ is a byte-identical copy or deterministic derivative of brand/; PNGs are supplied package renders and apple-touch is generated by the existing deterministic icon generator."
  ],
  "origin": "Pomelo-STEM brand v2.1 at commit 871aee8",
  "apps": {
    "seller": {
      "favicon": "pomelo-compact.svg",
      "header": "pomelo-compact.svg",
      "pwaAny": "pomelo-icon-square-192.png",
      "pwaMaskable": "pomelo-icon-maskable-192.png"
    },
    "shop": {
      "favicon": "pomelo-compact.svg",
      "header": "pomelo-compact.svg",
      "pwaAny": "pomelo-icon-square-192.png",
      "pwaMaskable": "pomelo-icon-maskable-192.png"
    }
  }
}
