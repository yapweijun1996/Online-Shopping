{
  auto_https off
}

(proxy) {
  reverse_proxy backend:3000 {
    header_up X-Real-IP {header.CF-Connecting-IP}
  }
}

# Cloudflare Web Analytics is injected by Cloudflare at the edge; its beacon script and endpoint are the only third-party
# origins allowed (https://developers.cloudflare.com/fundamentals/reference/policies-compliances/content-security-policies/).
(headers) {
  encode zstd gzip
  header X-Content-Type-Options nosniff
  header Referrer-Policy strict-origin-when-cross-origin
  header Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com/beacon.min.js; style-src 'self'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  header Cache-Control "no-cache"
}

http://shop.gmb01.xyz {
  import headers
  @private path /seller /seller/* /api/v1/seller/* /demo /demo/* /api/v1/demo/*
  handle @private {
    respond 404
  }
  @api path /api/* /health /ready
  handle @api {
    import proxy
  }
  redir / /shop/ 302
  redir /shop /shop/ 302
  # Content-hashed gallery images never change, so browsers and Cloudflare may keep them for a year.
  @gallery path_regexp ^/demo-assets/[A-Z0-9-]+/view-\d+-[a-f0-9]{12}-\d+\.jpg$
  handle @gallery {
    header Cache-Control "public, max-age=31536000, immutable"
    root * /srv/public
    file_server
  }
  handle {
    root * /srv/public
    file_server
  }
}

http://seller.gmb01.xyz {
  import headers
  @private {
    path /shop /shop/* /demo /demo/* /api/v1/demo/* /api/v1/orders /api/v1/orders/*
    not path /shop/tokens.css
  }
  handle @private {
    respond 404
  }
  @api path /api/* /health /ready
  handle @api {
    import proxy
  }
  redir / /seller/ 302
  redir /seller /seller/ 302
  handle {
    root * /srv/public
    file_server
  }
}

:80 {
  respond 404
}
