SHOP_HOST=demoonlineshopping.xyz
SELLER_HOST=seller.demoonlineshopping.xyz
ADMIN_USERNAME=owner
SECRETS_DIR=/opt/cloudops/secrets/online-shopping
# Enable together only after enable-platform.py succeeds. No legacy PLATFORM_ADMIN credentials.
PLATFORM_ENABLED=0
PLATFORM_ADMIN_CLAIM_ENABLED=0
# Set to /run/secrets/integration_keys at activation; empty avoids starting WhatsApp work while off.
INTEGRATION_KEY_FILE=
# Seller MCP connector (Claude / ChatGPT). Comma-separated exact vendor OAuth callbacks, no spaces.
MCP_ENABLED=0
MCP_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://chatgpt.com/connector_platform_oauth_redirect
# Optional WhatsApp linked-device (QR) worker; needs INTEGRATION_KEY_FILE and SECRETS_DIR/whatsapp-qr-token.
WHATSAPP_QR_ENABLED=0
# Before installing compose.yaml, create both SECRETS_DIR/whatsapp-qr-token-slot1
# and SECRETS_DIR/whatsapp-qr-bindings.json as regular non-empty host files,
# even with QR disabled or legacy slot 0 only. Preserve whatsapp-qr-token.
# With WHATSAPP_QR_BINDINGS_FILE empty, a placeholder [] manifest is ignored.
WHATSAPP_QR_SLOT1_ENABLED=0
WHATSAPP_QR_BINDINGS_FILE=
