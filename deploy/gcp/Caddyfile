{
	auto_https off
	admin off
}
(proxy) {
	reverse_proxy backend:3000 {
		header_up X-Real-IP {header.X-Real-IP}
	}
}
(headers) {
	encode gzip
	header X-Content-Type-Options nosniff
	header Strict-Transport-Security "max-age=31536000"
	header Referrer-Policy strict-origin-when-cross-origin
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
	header Cache-Control no-cache
}
(tenant) {
	# API requests retain their prefix; static requests pass the metadata-only gate.
	@tenant {
		path_regexp tenant ^/([a-z0-9]{3,30})(?:/|$)
		not path_regexp ^/(setup|admin|api|mcp|oauth|shop|seller|demo|www|health|ready|static|assets|shared|platform|default|login|logout|public|root|support|system|test|tenant|tenants|webhook|webhooks|sw|manifest|favicon|icons|p|s)(?:/|$)
	}
	handle @tenant {
		route {
			@tenant_api path_regexp ^/[a-z0-9]{3,30}/(?:api/|{args[0]}/manifest\.webmanifest$|p/|s/|mcp$|oauth/|\.well-known/oauth-)
			handle @tenant_api {
				import proxy
			}
			forward_auth backend:3000 {
				uri /{re.tenant.1}/api/v1/tenant-access
				header_up X-Tenant-Original-Uri {http.request.orig_uri}
				header_up X-Real-IP {header.X-Real-IP}
			}
			@tenant_crawler {
				host {$SHOP_HOST}
				path_regexp ^/[a-z0-9]{3,30}/(?:shop/?)?$
				header_regexp User-Agent (?i)(facebookexternalhit|facebot|whatsapp|twitterbot|telegrambot|slackbot|discordbot|googlebot|bingbot)
			}
			handle @tenant_crawler {
				rewrite * /{re.tenant.1}/s/home
				import proxy
			}
			@tenant_entry path_regexp ^/[a-z0-9]{3,30}/?$
			handle @tenant_entry {
				redir * /{re.tenant.1}/{args[0]}/ 302
			}
			@tenant_static path_regexp tenant_static ^/([a-z0-9]{3,30})/({args[0]}(?:/.*)?|shared/.*|shop/tokens\.css)$
			handle @tenant_static {
				rewrite * /{re.tenant_static.2}
				root * /srv/public
				file_server
			}
			handle {
				respond 404
			}
		}
	}
}
http://{$SHOP_HOST} {
	import headers
	route {
		@encoded expression `{http.request.orig_uri}.matches('^/[^/?]*%|^//|.*\\\\.*')`
		handle @encoded {
			respond 404
		}
		# Never serve setup from the frontend image or overwrite Node privacy headers.
		@setup path /setup/ /setup/setup.js /setup/setup.css /api/v1/setup/status /api/v1/setup/claim
		handle @setup {
			header Cache-Control no-store
			header Referrer-Policy no-referrer
			header X-Robots-Tag noindex
			import proxy
		}
		@private {
			path /setup* /api/v1/setup* /seller* /api/v1/seller* /demo /demo/* /api/v1/demo* /platform* /api/v1/platform* /s/*
		}
		handle @private {
			respond 404
		}
		@tenant_private path_regexp ^/[a-z0-9]{3,30}/(?:setup.*|api/v1/setup.*|platform.*|api/v1/platform.*|demo(?:/|$)|api/v1/demo(?:/|$)|seller.*|api/v1/seller(?:/|$))
		handle @tenant_private {
			respond 404
		}
		import tenant shop
		@api path /api/* /health /ready /p/*
		handle @api {
			import proxy
		}
		@crawler {
			path / /shop /shop/
			header_regexp User-Agent (?i)(facebookexternalhit|facebot|whatsapp|twitterbot|telegrambot|slackbot|discordbot|googlebot|bingbot)
		}
		handle @crawler {
			rewrite * /s/home
			import proxy
		}
		redir / /shop/ 302
		redir /shop /shop/ 302
		@static path /shop/* /shared/* /demo-assets/* /favicon.ico /favicon.svg /robots.txt
		handle @static {
			root * /srv/public
			file_server
		}
		handle {
			respond 404
		}
	}
}
http://{$SELLER_HOST} {
	import headers
	route {
		@encoded expression `{http.request.orig_uri}.matches('^/[^/?]*%|^//|.*\\\\.*')`
		handle @encoded {
			respond 404
		}
		@private {
			path /setup* /api/v1/setup* /shop* /p/* /s/* /api/v1/orders* /demo /demo/* /api/v1/demo*
			not path /shop/tokens.css
		}
		handle @private {
			respond 404
		}
		@tenant_private {
			path_regexp ^/[a-z0-9]{3,30}/(?:setup.*|api/v1/setup.*|platform.*|api/v1/platform.*|demo(?:/|$)|api/v1/demo(?:/|$)|shop.*|[ps](?:/|$)|api/v1/orders(?:/|$))
			not path_regexp ^/[a-z0-9]{3,30}/shop/tokens\.css$
		}
		handle @tenant_private {
			respond 404
		}
		# Seller MCP connector: the backend answers 404 unless MCP_ENABLED=1, and OAuth responses stay no-store.
		@connector path /mcp /oauth/register /oauth/authorize /oauth/token /oauth/revoke /oauth/consent.js /oauth/consent.css /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/* /.well-known/oauth-authorization-server /.well-known/oauth-authorization-server/*
		handle @connector {
			header Cache-Control no-store
			import proxy
		}
		import tenant seller
		@api path /api/* /health /ready
		handle @api {
			import proxy
		}
		redir /platform /platform/ 302
		redir / /seller/ 302
		redir /seller /seller/ 302
		@static path /seller/* /platform/* /shared/* /shop/tokens.css /favicon.ico /favicon.svg
		handle @static {
			root * /srv/public
			file_server
		}
		handle {
			respond 404
		}
	}
}
:80 {
	respond 404
}
