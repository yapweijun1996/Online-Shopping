[Unit]
Description=Recover the accepted Online Shopping codec into a fresh sealed generation
After=docker.service network-online.target
Requires=docker.service
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/online-shopping-gcp/update.py --root /opt/online-shopping-gcp recover-codec
TimeoutStartSec=5min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/online-shopping-gcp
