# Copy to ignored .local/docker.env and set a unique username.
ADMIN_USERNAME=
ADMIN_PASSWORD_FILE_HOST=./.local/admin-password

# Loopback-only local Docker smoke defaults.
NODE_ENV=development
SITE_ADDRESS=:80
PUBLIC_ORIGIN=http://127.0.0.1:8080
FRONTEND_HTTP_BIND=127.0.0.1:8080
FRONTEND_HTTPS_BIND=127.0.0.1:8443

# Future HTTPS host, only after release gates:
# NODE_ENV=production
# SITE_ADDRESS=shop.example.com
# PUBLIC_ORIGIN=https://shop.example.com
# FRONTEND_HTTP_BIND=0.0.0.0:80
# FRONTEND_HTTPS_BIND=0.0.0.0:443
