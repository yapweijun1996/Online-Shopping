{$SITE_ADDRESS} {
	encode zstd gzip
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"

	@tenant {
		path_regexp tenant ^/([a-z0-9]{3,30})(?:/|$)
		not path_regexp ^/(admin|api|shop|seller|demo|www|health|ready|static|assets|shared|platform|default|login|logout|public|root|support|system|test|tenant|tenants|webhook|webhooks|sw|manifest|favicon|icons|p|s)(?:/|$)
	}
	handle @tenant {
		route {
			@tenant_api path_regexp ^/[a-z0-9]{3,30}/(?:api/|(?:shop|seller)/manifest\.webmanifest$|p/|s/)
			handle @tenant_api {
				reverse_proxy backend:3000
			}
			forward_auth backend:3000 {
				uri /{re.tenant.1}/api/v1/tenant-access
				header_up X-Tenant-Original-Uri {http.request.orig_uri}
			}
			@tenant_entry path_regexp ^/[a-z0-9]{3,30}/?$
			handle @tenant_entry {
				redir * /{re.tenant.1}/shop/ 302
			}
			@tenant_static path_regexp tenant_static ^/[a-z0-9]{3,30}/((?:shop|seller|shared)/.*)$
			handle @tenant_static {
				rewrite * /{re.tenant_static.1}
				root * /srv/public
				file_server
			}
			handle {
				respond 404
			}
		}
	}

	@api path /api/* /health /ready
	handle @api {
		reverse_proxy backend:3000 {
			header_up X-Real-IP {$CLIENT_IP_SOURCE:{remote_host}}
		}
	}

	# Share links (see src/share.js): /p/<id> goes to the backend; link crawlers asking for the shop home
	# get its preview tags.
	@share path /p/*
	handle @share {
		reverse_proxy backend:3000 {
			header_up X-Real-IP {$CLIENT_IP_SOURCE:{remote_host}}
		}
	}
	@crawler_home {
		path / /shop /shop/
		header_regexp ua User-Agent (?i)(facebookexternalhit|facebot|meta-externalagent|facebookcatalog|whatsapp|twitterbot|telegrambot|slackbot|discordbot|linkedinbot|pinterest|skypeuripreview|applebot|googlebot|bingbot|line-poker|viber)
	}
	handle @crawler_home {
		rewrite * /s/home
		reverse_proxy backend:3000 {
			header_up X-Real-IP {$CLIENT_IP_SOURCE:{remote_host}}
		}
	}

	# Let the backend mode gate decide whether the fictional workspace is available.
	@demo path /demo /demo/*
	handle @demo {
		forward_auth backend:3000 {
			uri /api/v1/demo/availability
		}
		root * /srv/public
		header Cache-Control "no-cache"
		file_server
	}

	redir / /shop/ 302
	redir /shop /shop/ 302
	redir /seller /seller/ 302

	handle {
		root * /srv/public
		header Cache-Control "no-cache"
		file_server
	}
}
