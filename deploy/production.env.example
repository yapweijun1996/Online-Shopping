# Copy into the operator-only .local directory; do not commit real values.
ADMIN_USERNAME=
ADMIN_PASSWORD_FILE_HOST=./.local/production-admin-password
DATABASE_OWNER_PASSWORD_FILE_HOST=./.local/postgres-owner-password
DATABASE_PASSWORD_FILE_HOST=./.local/postgres-password
TUNNEL_CREDENTIALS_FILE_HOST=./.local/tunnel-credentials.json
# One line per key: id=<32 random bytes in base64>; the first line is the active key. Keep a copy apart from database backups.
INTEGRATION_KEY_FILE_HOST=./.local/integration-keys
# Complete the ordered additive platform setup before deploying R4. Paths must be absolute in runtime.env.
PLATFORM_ENABLED=
PLATFORM_ADMIN_HOST=
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD_FILE_HOST=
PLATFORM_DATABASE_PASSWORD_FILE_HOST=
PLATFORM_PROVISIONER_PASSWORD_FILE_HOST=
TUNNEL_ADMIN_CREDENTIALS_FILE_HOST=
