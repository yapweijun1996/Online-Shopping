# Copy to ignored .dev.vars for `npx wrangler dev`. Never commit .dev.vars.
NODE_ENV=development
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Leave empty locally; wrangler dev uses the request origin.
PUBLIC_ORIGIN=

# Data mode is separate from HTTPS/security environment. Demo seeds an empty store.
SHOP_MODE=public-demo
SHOP_DEMO_REVISION=v1
