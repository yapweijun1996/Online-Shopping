{
  "name": "online-shopping-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "check": "node scripts/check.js",
    "worker:dev": "wrangler dev",
    "worker:smoke": "node --env-file=.dev.vars scripts/worker-smoke.js",
    "worker:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "worker:deploy": "wrangler deploy",
    "test:integrations": "node --test --test-concurrency=1 test/integrations.test.js test/integration-adapters.test.js test/integration-trust.test.js",
    "test:studio": "node --test --test-concurrency=1 test/seller-studio.test.js",
    "test:customer-discovery": "node scripts/qa-customer-discovery.mjs",
    "test:customer-profile-address": "node scripts/qa-customer-profile-address.mjs",
    "test:seller-catalog-state": "node scripts/qa-seller-catalog-state.mjs",
    "test:seller-session-ui": "node scripts/qa-seller-session-ui.mjs",
    "test:usability-palette": "node scripts/qa-usability-palette.mjs",
    "test:schema-compatibility": "node --test --test-concurrency=1 test/postgres-schema-compatibility.test.js test/schema-recovery.test.js",
    "test:integrated-repair": "node scripts/qa-integrated-repair.mjs"
  },
  "dependencies": {
    "libphonenumber-js": "1.13.14",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "wrangler": "4.145.0"
  }
}
