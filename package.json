{
  "name": "online-shopping-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "check": "node scripts/check.js",
    "worker:dev": "wrangler dev",
    "worker:smoke": "node --env-file=.dev.vars scripts/worker-smoke.js",
    "worker:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "libphonenumber-js": "1.13.14"
  },
  "devDependencies": {
    "wrangler": "4.145.0"
  }
}
